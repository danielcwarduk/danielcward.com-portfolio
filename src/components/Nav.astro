---
/**
 * Nav — site header.
 *
 * Source: nav / bar
 *
 * The link list is written twice on purpose: one copy inline for wide
 * viewports, one inside the <details> overlay below 800px. A closed <details>
 * hides its children through the UA stylesheet, which CSS cannot reliably
 * override, so a single shared copy cannot also be the always-visible desktop
 * row. Fourteen duplicated lines beat a component that renders nothing on
 * desktop.
 */

import type { Action } from '../data/content';

interface Props {
	links: Action[];
	brand: string;
}

const { links, brand } = Astro.props;

// Derived from the request, not passed in, so the current page is always
// marked — including home, which is not one of `links`.
const path = Astro.url.pathname;

const isExternal = (href: string) => /^https?:\/\//.test(href);

// `trailingSlash: 'always'` means both the request path and every href in
// navLinks already carry the trailing slash, so they compare directly.
const isCurrent = (href: string) =>
	!isExternal(href) && (path === href || path.startsWith(href));
---

<header class="nav">
	<a class="nav__brand" href="/" aria-current={path === '/' ? 'page' : undefined}>
		{brand}
	</a>

	<nav class="nav__links" aria-label="Primary">
		{
			links.map((link) => (
				<a
					class="nav__link meta"
					href={link.href}
					aria-current={isCurrent(link.href) ? 'page' : undefined}
				>
					{link.label}
				</a>
			))
		}
	</nav>

	<details class="nav-menu">
		<summary class="nav-menu__toggle" aria-label="Toggle navigation">
			<svg aria-hidden="true" viewBox="0 0 24 24">
				<path class="nav-menu__icon-top" d="M4 7h16" />
				<path class="nav-menu__icon-middle" d="M4 12h16" />
				<path class="nav-menu__icon-bottom" d="M4 17h16" />
			</svg>
		</summary>
		<nav class="nav-menu__links" aria-label="Primary">
			{
				links.map((link) => (
					<a
						class="nav__link meta"
						href={link.href}
						aria-current={isCurrent(link.href) ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</details>
</header>

<script>
	/**
	 * The open overlay covers the viewport, so the page behind it has to stop
	 * being reachable — by Tab, and by scroll. `inert` on everything outside
	 * the menu handles focus and the tab order in one attribute, and is better
	 * than a hand-rolled trap: it cannot desync from the DOM.
	 *
	 * Escape is the other half — <details> has no built-in dismissal, and a
	 * keyboard user has no other way out once focus is inside.
	 */
	const menu = document.querySelector<HTMLDetailsElement>('.nav-menu');
	const toggle = menu?.querySelector<HTMLElement>('.nav-menu__toggle');
	// Everything the overlay covers: the brand and skip-link inside the header,
	// and every sibling of the header.
	const behind = document.querySelectorAll<HTMLElement>(
		'.nav__brand, body > :not(header)'
	);

	const applyState = () => {
		behind.forEach((el) => (el.inert = menu!.open));
		document.body.style.overflow = menu!.open ? 'hidden' : '';
	};

	menu?.addEventListener('toggle', applyState);

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && menu?.open) {
			menu.open = false;
			toggle?.focus();
		}
	});

	/*
	 * Crossing the breakpoint upwards while the overlay is open hides it without
	 * firing `toggle`, which would leave main inert and the body unscrollable
	 * behind a display:none menu — a page that looks fine and takes no input.
	 * Closing first fires `toggle` as a side effect, so applyState above
	 * unwinds it.
	 */
	const wide = window.matchMedia('(width >= 800px)');
	wide.addEventListener('change', () => {
		if (wide.matches && menu?.open) menu.open = false;
	});
</script>

<style>
	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-md);
		padding: clamp(32px, 5vw, 64px) var(--layout-gutter);
		max-width: var(--layout-board);
		margin-inline: auto;
	}

	.nav__brand {
		color: var(--fg);
		font-size: var(--type-body-lg-size);
		line-height: 1.1;
	}

	.nav__links {
		display: flex;
		flex: 1 1 450px;
		align-items: center;
		justify-content: flex-end;
		gap: var(--space-md);
		flex-wrap: wrap;
	}

	.nav__link {
		color: var(--fg);
		font-size: var(--type-body-sm-size);
		transition: color var(--duration-fast) var(--ease-standard);
	}

	.nav__link:hover {
		color: var(--fg-accent-text);
	}

	/* The current page carries an underline as well as the accent colour, so
	   it is not signalled by hue alone (WCAG 1.4.1). */
	.nav__link[aria-current='page'] {
		color: var(--fg-accent-text);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.35em;
	}

	.nav-menu {
		display: none;
	}

	.nav-menu__toggle {
		display: flex;
		align-items: center;
		gap: var(--space-xs);
		padding: var(--space-xs) var(--space-md);
		border: 1px solid var(--border-muted);
		border-radius: var(--radius-pill);
		cursor: pointer;
		list-style: none;
	}

	.nav-menu__toggle::-webkit-details-marker {
		display: none;
	}

	.nav-menu__toggle svg {
		width: 24px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: round;
	}

	.nav-menu[open] {
		position: fixed;
		z-index: 10;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: center;
		min-height: 100vh;
		min-height: 100dvh;
		overflow-y: auto;
		padding: var(--layout-gutter);
		background: var(--bg);
	}

	.nav-menu[open] .nav-menu__toggle {
		position: absolute;
		top: clamp(32px, 5vw, 64px);
		right: var(--layout-gutter);
	}

	.nav-menu[open] .nav-menu__icon-top {
		transform: translateY(5px) rotate(45deg);
	}

	.nav-menu[open] .nav-menu__icon-middle {
		opacity: 0;
	}

	.nav-menu[open] .nav-menu__icon-bottom {
		transform: translateY(-5px) rotate(-45deg);
	}

	.nav-menu__links {
		display: grid;
		gap: var(--space-md);
		width: min(100%, 28rem);
		margin-inline: auto;
		animation: nav-menu-enter 240ms var(--ease-standard) both;
	}

	.nav-menu__links .nav__link {
		font-family: var(--font-display);
		font-size: clamp(32px, 7vw, 64px);
		line-height: 1.05;
	}

	.nav-menu__toggle svg path {
		transform-box: fill-box;
		transform-origin: center;
		transition:
			transform var(--duration-fast) var(--ease-standard),
			opacity var(--duration-fast) var(--ease-standard);
	}

	@keyframes nav-menu-enter {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}
	@media (width < 800px) {
		.nav__links {
			display: none;
		}

		.nav-menu {
			display: block;
			margin-left: auto;
		}
	}
</style>

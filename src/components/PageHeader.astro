---
/**
 * PageHeader — the rule, title and intro that every interior page opens with.
 *
 * Sources: Blog / Desktop, Client Work / Desktop, Lab / Desktop
 */

import Divider from './Divider.astro';

interface Props {
	title: string;
	intro?: string;
}

const { title, intro } = Astro.props;
---

<header class="stack-md">
	<Divider />
	<h1 class="display-lg">{title}</h1>
	{intro && <p class="intro body-md">{intro}</p>}
</header>

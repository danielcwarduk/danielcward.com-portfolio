---
/**
 * SectionHeader — heading with an optional trailing action.
 *
 * Sources: latest / header, photography / head, cases-heading, demos-heading
 */

import Button from './Button.astro';
import type { Action } from '../data/content';

interface Props {
	title: string;
	level?: 'md' | 'lg';
	action?: Action;
}

const { title, level = 'md', action } = Astro.props;
---

<div class="section-header">
	<h2 class:list={[level === 'lg' ? 'heading-lg' : 'display-md']}>{title}</h2>

	{action && <Button href={action.href} variant="inverse">{action.label}</Button>}
</div>

<style>
	.section-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
	}
</style>

---
/**
 * Hero — the inverted hero panel.
 *
 * Source: hero / field
 */

import Button from './Button.astro';
import type { Action } from '../data/content';

interface Props {
	heading: string;
	role: string;
	lead: string;
	primary: Action;
	secondary: Action;
}

const { heading, role, lead, primary, secondary } = Astro.props;
---

<section class="hero on-inverse">
	<h1 class="hero__heading display-xl">{heading}</h1>

	<p class="hero__role body-lg">{role}</p>
	<p class="hero__lead">{lead}</p>

	<div class="hero__actions">
		<Button href={primary.href} variant="accent">{primary.label}</Button>
		<Button href={secondary.href} variant="solid">{secondary.label}</Button>
	</div>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		padding: clamp(var(--space-xl), 7.5vw, var(--space-3xl));
		border-radius: clamp(24px, calc(0.88vw + 20.7px), 32px);
	}

	.hero__role,
	.hero__lead {
		color: var(--fg-muted);
	}

	.hero__lead {
		max-width: 60ch;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-sm);
		margin-top: var(--space-xs);
	}
</style>

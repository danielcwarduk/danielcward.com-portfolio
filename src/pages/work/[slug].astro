---
/**
 * A case study, rendered from its markdown file in src/content/work.
 */

import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { breadcrumbs } from '../../data/content';

export async function getStaticPaths() {
	const cases = await getCollection('work', ({ data }) => data.published);

	return cases.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

interface Props {
	item: CollectionEntry<'work'>;
}

const { item } = Astro.props;
const { Content } = await render(item);

const path = `/work/${item.id}/`;
---

<BaseLayout
	title={item.data.title}
	description={item.data.copy}
	schema={[breadcrumbs('Client Work', '/work/', path, item.data.title)]}
>
	<div class="board">
		<div class="stack-sm">
			<PageHeader title={item.data.title} intro={item.data.copy} />

			<p class="meta-row fine">
				<span>{item.data.year}</span>
				<span aria-hidden="true">·</span>
				<a href={item.data.href}>
					{item.data.visitLabel}
					<span aria-hidden="true"> ↗</span>
				</a>
			</p>

			<div class="prose body-md">
				<Content />
			</div>
		</div>
	</div>
</BaseLayout>
---
/**
 * Notes index — built from the "Blog / Desktop" board in Penpot.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactLink from '../../components/ContactLink.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostListItem from '../../components/PostListItem.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { allNotes, formatDate, isoDate } from '../../data/collections';
---

<BaseLayout
	title="Notes"
	description="Notes on front-end architecture, shader programming, and organising photo archives — the decisions and dead ends behind Daniel C. Ward's web development work."
>
	<div class="board">
		<PageHeader
			title="Notes"
			intro="Notes I don't want to lose, written up in case they help someone else."

		/>

		<section class="stack-lg">
			<SectionHeader title="Writing" level="lg" />

			<div>
				{
					allNotes.map((note) => (
						<PostListItem
							href={note.data.published ? `/notes/${note.id}/` : undefined}
							published={note.data.published}
							title={note.data.title}
							excerpt={note.data.excerpt}
							date={formatDate(note.data.date)}
							isoDate={isoDate(note.data.date)}
							readingTime={note.data.readingTime}
						/>
					))
				}
			</div>
		</section>

		<ContactLink prompt="Have a question or an idea?" />
	</div>
</BaseLayout>

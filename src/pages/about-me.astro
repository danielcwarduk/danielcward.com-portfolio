---
/**
 * About — profile, selected experience and a printable CV.
 *
 * The experience below mirrors the current downloadable CV, while keeping the
 * page useful as a short introduction rather than reproducing every detail.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import ContactPanel from '../components/ContactPanel.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { profiles } from '../data/content';

const experience = [
	{
		role: 'Freelance Web Developer',
		company: 'Captain Cycles · Sheffield',
		period: 'January–May 2026',
		summary:
			'Translated the client’s requirements into a practical service website and a custom WordPress theme.',
		highlights: [
			'Planned the layout and visual direction in Penpot',
			'Developed locally and deployed through Bluehost',
			'Taught the client to manage content independently',
		],
	},
	{
		role: 'Freelance Web Developer',
		company: 'Captain T Productions · Sheffield',
		period: 'February–June 2026',
		summary:
			'Designed and developed a custom WordPress website for a photography, cinematography and drone business.',
		highlights: [
			'Planned the interface and layout in Penpot',
			'Deployed the completed website through Bluehost',
			'Guided the client through future content changes',
		],
	},
	{
		role: 'Web Development Work Experience',
		company: 'If Collective',
		period: 'June 2025 · Four days',
		summary:
			'Worked on real client projects, turning designs into working interfaces and learning how to apply design specifications in a professional workflow.',
		highlights: [
			'Built interfaces with HTML and CSS',
			'Used Figma Dev Mode to work from design specifications',
			'Contributed to animation and gradient work',
		],
	},
];

const skills = [
	'Astro, WordPress, HTML, CSS and JavaScript',
	'Python, Go and TypeScript',
	'HTMX and responsive front-end development',
	'Git and GitHub Actions',
	'Penpot, Figma and design handoff',
	'Client communication and requirements gathering',
	'Planning, technical problem-solving and QA',
	'Accessible content structure and client handover',
];
---

<BaseLayout
	title="About me"
	description="About Daniel C. Ward, a UK-based web developer and photographer building clear, maintainable websites."
>
	<div class="board">
		<PageHeader
			title="About me"
			intro="Web developer and photographer, working from the UK."
		/>

		<section class="about-intro" aria-labelledby="about-intro-title">
			<div class="about-intro__copy stack-md">
				<h2 id="about-intro-title" class="heading-lg">Useful websites, made to last.</h2>
				<p class="body-md">
					I build websites for people who need them to be clear, quick and manageable after
					launch. Most of my client work uses WordPress or Astro, chosen for the project rather
					than for fashion.
				</p>
				<p class="body-md">
					Away from the browser, I make photographs when the light is right. That practice
					keeps me attentive to composition, restraint and the details that make a page feel
					considered.
				</p>
			</div>

			<aside class="about-intro__aside stack-sm" aria-label="Profile links">
				<p class="label">Find me online</p>
				<a href={profiles.linkedin} rel="me">LinkedIn</a>
				<a href={profiles.github} rel="me">GitHub</a>
			</aside>
		</section>

		<section class="photography-feature on-inverse" aria-labelledby="photography-title">
			<div class="stack-md">
				<p class="label">Photography</p>
				<h2 id="photography-title" class="heading-lg">Coming soon.</h2>
				<p class="body-md">
					I’m putting together a gallery of landscapes and street work. It will be here when
					it’s ready.
				</p>
			</div>
			<a class="photography-feature__link label-md" href="/photography/">
				Visit the photography page
			</a>
		</section>

		<section class="cv-section stack-lg" aria-labelledby="cv-title">
			<SectionHeader title="CV" level="lg" />

			<div class="cv-section__content">
				<div class="stack-md">
					<h3 id="cv-title" class="heading-md">Profile</h3>
					<p class="body-md">
						I help small businesses turn their ideas and content into dependable websites.
						My work covers the design and build, but also the practical details around it:
						performance, accessibility, deployment and showing clients how to make changes
						themselves.
					</p>
				</div>

				<div class="cv-download on-inverse">
					<p class="label">Printable version</p>
					<p class="body-sm">Keep a copy of my CV for your records.</p>
					<a
						class="cv-download__button label-md"
						href="/Ward-Daniel-CV.pdf"
						download="Ward-Daniel-CV.pdf"
					>
						Download CV
					</a>
				</div>
			</div>

			<div class="cv-facts">
				<div class="stack-sm">
					<p class="label">Education</p>
					<p class="body-sm">
						<strong>T Level Technical Qualification in Digital Software Development</strong><br />
						The Sheffield College · September 2026–Present
					</p>
				</div>
				<div class="stack-sm">
					<p class="label">Certification</p>
					<p class="body-sm">Cisco — Python Essentials (in progress)</p>
				</div>
				<div class="stack-sm">
					<p class="label">GCSEs</p>
					<p class="body-sm">The Birley Academy · 2021–2026</p>
					<ul class="grade-list fine">
						<li>English Literature <strong>6</strong></li>
						<li>English Language <strong>6</strong></li>
						<li>Maths <strong>7</strong></li>
						<li>Physics <strong>6</strong></li>
						<li>Chemistry <strong>7</strong></li>
						<li>Biology <strong>7</strong></li>
						<li>History <strong>6</strong></li>
						<li>French <strong>6</strong></li>
						<li>Creative Media <strong>M2</strong></li>
					</ul>
				</div>
			</div>
		</section>

		<section class="stack-lg" aria-labelledby="experience-title">
			<SectionHeader title="Experience" level="lg" />

			<div class="experience-list">
				{experience.map((item) => (
					<article class="experience-item">
						<header class="experience-item__header">
							<div class="stack-sm">
								<h3 class="heading-md">{item.role}</h3>
								<p class="body-sm">{item.company}</p>
							</div>
							<p class="experience-item__period label">{item.period}</p>
						</header>
						<p class="body-md experience-item__summary">{item.summary}</p>
						<ul class="experience-item__highlights">
							{item.highlights.map((highlight) => <li class="body-sm">{highlight}</li>)}
						</ul>
					</article>
				))}
			</div>
		</section>

		<section class="skills-section stack-lg" aria-labelledby="skills-title">
			<SectionHeader title="Skills" level="lg" />
			<h3 id="skills-title" class="sr-only">Skills and capabilities</h3>
			<ul class="skills-list">
				{skills.map((skill) => <li class="skills-list__item body-sm">{skill}</li>)}
			</ul>
		</section>

		<ContactPanel />
	</div>
</BaseLayout>

<style>
	.about-intro,
	.cv-section__content {
		display: grid;
		grid-template-columns: minmax(0, 2fr) minmax(220px, 1fr);
		gap: var(--space-2xl);
		align-items: start;
	}

	.about-intro__copy {
		max-width: 66ch;
	}

	.about-intro__aside {
		padding-block-start: var(--space-xs);
		border-block-start: var(--border-hairline);
	}

	.about-intro__aside a {
		width: fit-content;
		color: var(--fg-accent-text);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.about-intro__aside a:hover {
		text-decoration-thickness: 2px;
	}

	.photography-feature {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-xl);
		padding: clamp(var(--space-xl), 6vw, var(--space-2xl));
		border-radius: var(--radius-md);
	}

	.photography-feature__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-sm) var(--space-lg);
		border: 1px solid var(--border);
		border-radius: var(--radius-pill);
		color: var(--fg);
		white-space: nowrap;
		transition: background-color var(--duration-fast) var(--ease-standard);
	}

	.photography-feature__link:hover {
		background: #564c22;
	}

	.cv-download {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-sm);
		padding: var(--space-lg);
		border-radius: var(--radius-md);
	}

	.cv-download__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-sm) var(--space-lg);
		border-radius: var(--radius-pill);
		background: var(--core-cream);
		color: var(--core-olive);
		transition: filter var(--duration-fast) var(--ease-standard);
	}

	.cv-download__button:hover {
		filter: brightness(0.96);
	}

	.cv-facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-2xl);
		padding-block-start: var(--space-lg);
		border-block-start: var(--border-hairline);
	}

	.experience-list {
		display: flex;
		flex-direction: column;
	}

	.experience-item {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
		padding-block: var(--space-lg);
		border-block-start: var(--border-hairline);
	}

	.experience-item:last-child {
		border-block-end: var(--border-hairline);
	}

	.experience-item__header {
		display: flex;
		align-items: start;
		justify-content: space-between;
		gap: var(--space-md);
	}

	.experience-item__period {
		flex: 0 0 auto;
		padding-block-start: var(--space-xs);
		color: var(--fg-muted);
	}

	.experience-item__summary {
		max-width: var(--measure);
	}

	.experience-item__highlights {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-md);
		color: var(--fg-muted);
	}

	.experience-item__highlights li {
		padding-block-start: var(--space-sm);
		border-block-start: 1px solid var(--border);
	}

	.skills-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-sm) var(--space-2xl);
		max-width: 780px;
	}

	.skills-list__item {
		padding-block: var(--space-sm);
		border-block-start: 1px solid var(--border);
	}

	.grade-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-xs) var(--space-md);
		margin-block-start: var(--space-xs);
		color: var(--fg-muted);
	}

	.grade-list strong {
		color: var(--fg);
		font-weight: 600;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 767px) {
		.about-intro,
		.cv-section__content {
			grid-template-columns: 1fr;
			gap: var(--space-xl);
		}

		.photography-feature {
			align-items: start;
			flex-direction: column;
			gap: var(--space-xl);
		}

		.experience-item__header {
			flex-direction: column;
			gap: var(--space-sm);
		}

		.experience-item__highlights,
		.skills-list,
		.cv-facts,
		.grade-list {
			grid-template-columns: 1fr;
		}
	}
</style>

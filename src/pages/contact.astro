---
/**
 * Contact — built from the "Contact Page" board in Penpot
 * (panel / contact-card).
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import { contactFields, site } from '../data/content';
---

<BaseLayout
	title="Contact"
	description="Get in touch with Daniel C. Ward about the client work, the notes, or anything on this site."
>
	<div class="board">
		<Panel
			title={site.name}
			level={1}
			subtitle={site.role}
			bio="I build for the web — mostly WordPress and Astro, usually for someone with a business that needs a site which still works in three years. The case studies are on the work page. I like fast pages, honest type, and clients who are allowed to edit their own text afterwards."
			fields={contactFields}
		/>
	</div>
</BaseLayout>

---
/**
 * Client Work — built from the "Client Work / Desktop" board in Penpot.
 *
 * The list and the case studies are markdown files in src/content/work; the
 * frontmatter drives the card, the body is the case study.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card.astro';
import ContactPanel from '../components/ContactPanel.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { allCases } from '../data/collections';
---

<BaseLayout
	title="Client Work"
	description="All my work that I have done for real clients."
>
	<div class="board">
		<PageHeader
			title="Client Work"
			intro="Real projects I have done for real clients"
		/>

		<section class="stack-md">
			<SectionHeader title="Selected Work" level="lg" />

			<div class="stack-md">
				{
					allCases.map((item) => (
						<Card
							href={item.data.published ? `/work/${item.id}/` : undefined}
							title={item.data.title}
							copy={item.data.copy}
							meta={item.data.year}
							cta="Read the case study"
							size="lg"
						/>
					))
				}
			</div>
		</section>

		<ContactPanel />
	</div>
</BaseLayout>

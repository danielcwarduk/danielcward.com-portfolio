---
/**
 * Home — built from the "Home / Desktop" board in Penpot.
 * Sections, in order: hero / field, latest posts carousel,
 * client-work + concepts bands, photography, footer panel.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import ComingSoonModal from '../components/ComingSoonModal.astro';
import Hero from '../components/Hero.astro';
import ContactPanel from '../components/ContactPanel.astro';
import PostCarousel from '../components/PostCarousel.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { notes } from '../data/collections';
import { site } from '../data/content';
---

<BaseLayout description={site.description}>
	<div class="board">
		<Hero
			heading={site.name}
			role={site.role}
			lead="I build websites for people who need them to keep working. Client sites, small tools, and whatever experiment has my attention this month."
			primary={{ label: 'See my work', href: '/work/' }}
			secondary={{ label: 'Get in touch', href: '/contact/' }}
		/>

		<section class="stack-lg">
			<SectionHeader
				title="My notes"
				action={{ label: 'All notes', href: '/notes/' }}
			/>
			<p class="intro body-md">
				Notes I don't want to lose, written up in case they help someone else.
			</p>
			<PostCarousel notes={notes.slice(0, 3)} />
		</section>

		<div class="stack-md">
			<Band
				title="Client Work"
				summary="Two client sites, designed and built end to end, still running. WordPress, hand-rolled themes, nothing that needs a plugin to survive a year."
				action={{ label: 'See client work', href: '/work/' }}
				variant="heavy"
			/>
			<Band
				title="Concepts & Demos"
				summary="Things I build to find out whether they work. Some finished, most not."
				action={{ label: 'Explore concepts', href: '/lab/' }}
				variant="outlined"
			/>
		</div>

		<section class="stack-lg">
			<SectionHeader
				title="Also, photos"
			>
				<ComingSoonModal
					slot="action"
					label="Browse the gallery"
					destination={site.photosUrl}
				/>
			</SectionHeader>
		<p class="intro body-md">
			On a different site. Landscapes and street work, shot slowly and edited
			less than you'd think. That gallery is still being put together.
		</p>
		</section>

		<ContactPanel />
	</div>
</BaseLayout>
